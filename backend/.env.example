NEWS_API_KEY=your_news_api_key_here

# Local Ollama development configuration.
# LLM_API_KEY is not required when LLM_PROVIDER=ollama.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=700

# PostgreSQL
DATABASE_URL=postgresql+psycopg://stock_app:real_password@localhost:5432/stock_intelligence
# OpenAI-compatible alternative:
# LLM_PROVIDER=openai
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT=30
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=500

# To disable LLM generation safely:
# LLM_PROVIDER=none

# RAG test configuration. Keep embeddings disabled by default.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT=60

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_RETRIEVAL_K=5

# Uploaded text documents are indexed in process memory only.
DOCUMENT_UPLOAD_MAX_BYTES=1048576
DOCUMENT_TEXT_MAX_CHARS=100000
DOCUMENT_INDEX_MAX_DOCUMENTS=25
PDF_MAX_PAGES=100
PDF_MIN_EXTRACTED_CHARS=100

# For local Ollama RAG development, set:
# EMBEDDING_PROVIDER=ollama
